#!/bin/sh
# Resolve an installed symlink before locating the portable Lua entry point.
script_path=$0
case "$script_path" in */*) ;; *) script_path=$(command -v "$script_path") ;; esac
while [ -L "$script_path" ]; do
  script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd) || exit 1
  script_path=$(readlink "$script_path") || exit 1
  case "$script_path" in /*) ;; *) script_path=$script_dir/$script_path ;; esac
done
script_dir=$(CDPATH= cd -P "$(dirname "$script_path")" && pwd) || exit 1
lua_runtime=${RIVET_LUA:-lua}
if ! command -v "$lua_runtime" >/dev/null 2>&1; then
  printf '%s\n' 'Rivet requires Lua or LuaJIT for the CLI. Install Lua or set RIVET_LUA=luajit.' >&2
  exit 127
fi
exec "$lua_runtime" "$script_dir/rivet.lua" "$@"
