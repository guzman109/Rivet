{
	"name": "rivet-docs",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@fontsource/space-grotesk": "5.3.0",
		"@fontsource/space-mono": "5.3.0",
		"@opentelemetry/api": "1.9.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.4",
		"github-slugger": "2.0.0",
		"mdsvex": "0.12.8",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"rehype-slug": "6.0.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"vite": "8.3.3",
		"wrangler": "4.149.0",
		"yaml": "2.9.1"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun --bun vite dev --host 127.0.0.1",
		"build": "bun --bun vite build",
		"sync": "bun --bun svelte-kit sync",
		"check": "bun run sync && bun --bun svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "bun --bun prettier --write .",
		"lint": "bun --bun prettier --check .",
		"test:highlight": "bun test tests/highlight.test.ts",
		"check:docs": "bun scripts/validate-docs.ts",
		"cf:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
		"preview": "bun run build && bun run cf:dev",
		"cf:check": "bun run build && wrangler deploy --dry-run",
		"deploy": "bun run verify && wrangler deploy",
		"verify": "bun run check && bun run lint && bun run test:highlight && bun run build && bun run check:docs && bun run test:cloudflare",
		"test:cloudflare": "bun scripts/check-cloudflare.ts"
	}
}
